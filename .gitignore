# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*

# Compiled binaries built into the repo root. `go build ./cmd/kubectl-neo4j`
# writes ./kubectl-neo4j unless -o says otherwise, and a 37MB binary was once
# committed that way. Use `make build-cli`, which writes into bin/.
/kubectl-neo4j
/kubectl-neo4j.exe
/manager
main
# Compiled kubectl plugin binary (same name as its source dir — anchor so the
# pattern hits only the built binary, not the cmd/kubectl-neo4j/ source).
/cmd/kubectl-neo4j/kubectl-neo4j
Dockerfile.cross

# Claude Code: ship shared agent assets (.claude/skills/, .claude/settings.json),
# but never per-user scratch — local overrides, agent worktrees, scheduler lock.
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# GitMir dashboard telemetry (local-only, regenerated per machine) — the
# product model itself (.gitmir/model/*.json) IS committed and tracked.
.gitmir/footprint.json
.gitmir/usage.jsonl
.gitmir/progress.json

# Test binary, built with `go test -c`
*.test
e2e.test
integration.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
cover.out
coverage.html

# Go workspace file
go.work
go.work.sum

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*

# Development and testing
/tmp/
/logs/
/dist/
/.gocache/
samples/
!config/samples/
!config/samples/**
.air.toml
build-errors.log
results.sarif

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local development certificates
*.pem
*.crt
*.key
tls.crt
tls.key

# Temporary kubeconfig files
kubeconfig*
.kubeconfig

# Test YAML files in root (should be in examples/testing)
test-*.yaml
*-test.yaml

# Local development overrides
docker-compose.override.yml
.env
.env.local
.env.development

# Operator SDK generated files
config/manifests/*
!config/manifests/
!config/manifests/kustomization.yaml
!config/manifests/bases/
!config/manifests/bases/**

# Generated reports and coverage
/reports/
/coverage/
/test-results/
*.html
quality-summary.md

# Test artifacts
/test/artifacts/
.dev-config
test-output.log
integration-test-output.log

# Log files in project root
*.log
logs/*.log
update-alm-examples

# MkDocs build output
/site/

# gotestsum CI outputs
unit-tests.json
unit-junit.xml

# kubectl-neo4j support bundles. The command writes them to the CURRENT
# directory, so a verification journey run from inside the repo drops them
# wherever it happened to be. Eight were committed to cmd/kubectl-neo4j/
# across six commits before this rule existed (two still tracked at the time
# it was added). They are diagnostics from a throwaway Kind cluster and are
# never worth committing.
neo4j-support-bundle-*.tar.gz
neo4j-support-bundle-*/

# Local-only Claude Code instructions (per-developer, never committed)
CLAUDE.local.md
